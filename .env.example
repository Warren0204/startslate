# StartSlate Environment Configuration Template
# Copy to .env.local and fill in credentials before running locally.

# Supabase Project Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Gemini 2.5 Flash API Key (@google/genai)
GEMINI_API_KEY=your-gemini-api-key

# Cryptographic Keys (Server-only; 64 lowercase hex characters = 32 bytes for AES-256-GCM)
PII_ENCRYPTION_KEY=replace-with-64-char-hex-key
AUDIT_IP_SALT=replace-with-64-char-hex-salt

# Public Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
